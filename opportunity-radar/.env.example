# Official DeepSeek configuration for the local opportunity API.
# Keep the real key outside the repository.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Tikbit relay is only for final product image generation.
TIKBIT_API_KEY=
TIKBIT_BASE_URL=https://tikbit.ai
TIKBIT_IMAGE_MODEL=gpt-image-2.5-sunburst
OPPORTUNITY_API_STYLE=chat_completions
